# Server Configuration
PORT=3000

# ── WhatsApp Cloud API ──────────────────────────────────────────────────────
WHATSAPP_TOKEN=your_whatsapp_token_here
PHONE_NUMBER_ID=your_phone_number_id
META_API_VERSION=v20.0
VERIFY_TOKEN=sapatamu_secret_token_123

# ── Chatwoot ────────────────────────────────────────────────────────────────
CHATWOOT_BASE_URL=http://localhost:3001
CHATWOOT_API_TOKEN=your_chatwoot_api_token
CHATWOOT_ACCOUNT_ID=2
CHATWOOT_WEBHOOK_SECRET=
CHATWOOT_ESCALATION_TEAM_ID=1

# ── Google Gemini AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Escalation & Entry Triggers ─────────────────────────────────────────────
ESCALATION_KEYWORDS=alergi,komplain,darurat,refund,bicara sama orang,urgent,marah
CS_ENTRY_TRIGGERS=cs,bantuan,halo,hi,hello,hai,start,menu
